generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Les rôles, du plus puissant au moins puissant
enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  USER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  // Vide tant que la personne n'a pas accepté son invitation et choisi un mot de passe
  passwordHash String?
  role         Role     @default(USER)
  // false = compte désactivé : la personne ne peut plus se connecter
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tickets             Ticket[]
  invitations         Invitation[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Ticket {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(150)
  description String
  status      TicketStatus @default(OPEN)
  // L'utilisateur qui a créé le ticket
  authorId    Int
  author      User         @relation(fields: [authorId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status])
  @@index([authorId])
  @@map("tickets")
}

// Invitation envoyée par email : valable 48 h, utilisable une seule fois
model Invitation {
  id        Int       @id @default(autoincrement())
  // Empreinte (hash) du jeton : le jeton lui-même n'est jamais stocké
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("invitations")
}

// Session de connexion longue (refresh token) : révoquée à la déconnexion ou à la rotation
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Jeton de réinitialisation du mot de passe : valable 1 h, utilisable une seule fois
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}
