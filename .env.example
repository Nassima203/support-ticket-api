DATABASE_URL="postgresql://postgres:postgres@localhost:5432/support_tickets?schema=public"

# Jetons de connexion (JWT) : secret de signature et durée de vie
JWT_SECRET="remplace-moi-par-openssl-rand-hex-32"
JWT_EXPIRES_IN="15m"
# Durée de vie d'une session (refresh token), en jours
REFRESH_TOKEN_DAYS=7

# Emails (Resend) : laisser RESEND_API_KEY vide pour afficher les emails dans le terminal
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
# Adresse utilisée dans les liens envoyés par email
APP_URL="http://localhost:3000"
